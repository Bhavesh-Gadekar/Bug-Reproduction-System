# ==============================================================================
# Bug Reproduction Sandbox Runner — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# The sandbox service reads from the project-root .env first, then this file.
# ==============================================================================

# ── Service settings ───────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8001

# ── Container resource limits ──────────────────────────────────────────────────
# Fraction of a CPU available to each sandboxed container (e.g. 0.5 = half core)
DEFAULT_CPU_LIMIT=0.5

# Docker memory limit string (e.g. "256m", "512m", "1g")
DEFAULT_MEMORY_LIMIT=256m

# Maximum number of processes allowed inside each container
DEFAULT_PIDS_LIMIT=64

# ── Timeout settings ───────────────────────────────────────────────────────────
# Hard ceiling on timeout_seconds a caller may request (seconds)
MAX_TIMEOUT_SECONDS=120

# Extra seconds the watchdog waits before force-killing (timeout + grace)
WATCHDOG_GRACE_SECONDS=5

# ── Network ────────────────────────────────────────────────────────────────────
# Docker network for sandboxed containers.
# Use "none" in production for full isolation.
# Use "bug_repro_network" only for local debugging that requires network access.
SANDBOX_NETWORK=none

# ── Image pull behaviour ───────────────────────────────────────────────────────
# Set to "false" to disable automatic docker pull (images must be pre-pulled)
ALLOW_IMAGE_PULL=true
