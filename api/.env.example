# Database (Neon Serverless PostgreSQL)
NEON_DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# LLM Providers (Google Gemini)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Object Storage (Backblaze B2 - S3 Compatible Endpoint)
# Note: Format is https://s3.<region>.backblazeb2.com
B2_KEY_ID=your_b2_key_id_or_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=bug-reproduction-artifacts
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Redis (Message broker & task caching)
REDIS_URL=redis://localhost:6379/0

# API Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]
